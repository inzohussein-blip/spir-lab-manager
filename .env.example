# ── Data source ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to run on the embedded Postgres (PGlite) — zero setup
# locally. On a serverless host (Vercel) the PGlite data dir is EPHEMERAL, so
# unset means a demo-only database that resets between instances.
#
# For durable production data, set DATABASE_URL to a DEDICATED hosted Postgres
# connection string (its own Supabase / Neon project — NOT any shared instance).
# Apply the SQL under supabase/migrations to that database first.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
#
# Optional: PGSSL=disable to turn off TLS; PGPOOL_MAX=5 pool size;
# PGLITE_DATA_DIR=./.pglite-data to move the embedded data directory.

# ── Auth ────────────────────────────────────────────────────────────────────
# Session-signing secret. REQUIRED for any real deployment. Generate one:
#   openssl rand -base64 48
# AUTH_SECRET=replace-with-a-long-random-value

# ── AI Diagnostic Assistant (section 7) ─────────────────────────────────────
# Anthropic API key for the Claude-powered result summariser.
# ANTHROPIC_API_KEY=sk-ant-...
# Model override — defaults to claude-opus-5. Use claude-sonnet-5 for lower cost.
# ANTHROPIC_MODEL=claude-opus-5

# ── WhatsApp (section 5) — optional, MVP uses wa.me links (no key needed) ────
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_ID=

# ── Lab codes («منظومة الرموز») — one code per lab, bound to one device ──────
# Setting this switches the lab-code system on and is the owner's password for
# the code manager at /licenses. Unset = the local stations open without a code.
# Needs a durable DATABASE_URL (codes and the signing key are stored there).
# LICENSE_ADMIN_PASSWORD=…
# Optional contact line for the activation / lock screens (also editable in /licenses):
# STATION_ACTIVATION_CONTACT=…
