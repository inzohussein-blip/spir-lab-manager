# ── Data source ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to run on the embedded Postgres (PGlite) — zero setup.
# The SQL under supabase/migrations + supabase/seed.sql load automatically.
#
# For Vercel / a shared Supabase deployment, set DATABASE_URL to the SAME hosted
# Postgres connection string used by Spir-Margin (so both apps share one DB).
# Migrations in supabase/migrations must already be applied there.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
#
# Optional: PGSSL=disable to turn off TLS; PGPOOL_MAX=5 pool size;
# PGLITE_DATA_DIR=./.pglite-data to move the embedded data directory.

# ── Auth ────────────────────────────────────────────────────────────────────
# Session-signing secret. REQUIRED for any real deployment. To share single
# sign-on with Spir-Margin, use the SAME value in both apps. Generate one:
#   openssl rand -base64 48
# AUTH_SECRET=replace-with-a-long-random-value

# ── AI Diagnostic Assistant (section 7) ─────────────────────────────────────
# Anthropic API key for the Claude-powered result summariser.
# ANTHROPIC_API_KEY=sk-ant-...
# Model override — defaults to claude-opus-5. Use claude-sonnet-5 for lower cost.
# ANTHROPIC_MODEL=claude-opus-5

# ── WhatsApp (section 5) — optional, MVP uses wa.me links (no key needed) ────
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_ID=
