# Copy this file to .env (in this folder) and fill in the SAME values as the main site
# (Vercel → Settings → Environment Variables). .env stays on this machine: it is never committed.

# Required
DATABASE_URL=
AUTH_SECRET=
# The one address the clients open (the Cloudflare Worker), as on the other sites.
NEXT_PUBLIC_BASE_URL=

